generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  DRIVER
  ADMIN
}

enum DriverStatus {
  AVAILABLE
  ON_DELIVERY
  OFFLINE
  SUSPENDED
}

enum VehicleStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  INACTIVE
}

enum OrderStatus {
  CREATED
  CONFIRMED
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  REASSIGNED
  CANCELLED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer?
  driver   Driver?
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  createdAt DateTime @default(now())

  user   User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  orders DeliveryOrder[]
}

model Driver {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @unique @db.Uuid
  licenseNumber String       @unique
  status        DriverStatus @default(OFFLINE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignments DeliveryAssignment[]
}

model Vehicle {
  id                 String        @id @default(uuid()) @db.Uuid
  registrationNumber String        @unique
  capacityKg         Decimal       @db.Decimal(10, 2)
  status             VehicleStatus @default(AVAILABLE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  assignments DeliveryAssignment[]
}

model Warehouse {
  id      String @id @default(uuid()) @db.Uuid
  name    String
  address String

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  originOrders      DeliveryOrder[] @relation("OrderOriginWarehouse")
  destinationOrders DeliveryOrder[] @relation("OrderDestinationWarehouse")
}

model DeliveryOrder {
  id                     String  @id @default(uuid()) @db.Uuid
  customerId             String  @db.Uuid
  originWarehouseId      String? @db.Uuid
  destinationWarehouseId String? @db.Uuid

  pickupAddress   String
  deliveryAddress String
  recipientName   String
  recipientPhone  String

  weightKg Decimal     @db.Decimal(10, 2)
  deadline DateTime?
  status   OrderStatus @default(CREATED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  originWarehouse Warehouse? @relation("OrderOriginWarehouse", fields: [originWarehouseId], references: [id], onDelete: SetNull)

  destinationWarehouse Warehouse? @relation("OrderDestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: SetNull)

  assignments   DeliveryAssignment[]
  statusHistory OrderStatusHistory[]

  @@index([customerId, createdAt])
  @@index([status, deadline])
}

model DeliveryAssignment {
  id        String           @id @default(uuid()) @db.Uuid
  orderId   String           @db.Uuid
  driverId  String           @db.Uuid
  vehicleId String           @db.Uuid
  status    AssignmentStatus @default(ACTIVE)

  assignedAt DateTime  @default(now())
  releasedAt DateTime?

  order   DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  driver  Driver        @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicle Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([orderId, assignedAt])
  @@index([driverId, status])
  @@index([vehicleId, status])
}

model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @db.Uuid
  status    OrderStatus
  changedAt DateTime    @default(now())
  note      String?

  order DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, changedAt])
}
